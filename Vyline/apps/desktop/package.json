{
  "name": "@vyline/desktop-windows",
  "version": "0.1.0-beta.2",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "Vyline Desktop for Windows (Beta verification build)",
  "author": "Vyline contributors",
  "scripts": {
    "dev": "bun ./node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "pr:video": "bun scripts/record-pr-video-openscreen.ts",
    "pr:video:openscreen": "bun scripts/record-pr-video-openscreen.ts",
    "pr:video:live": "bun scripts/record-pr-video-live.ts",
    "pr:video:demo": "bun scripts/record-pr-demo-clips.ts",
    "pr:video:clips": "bun scripts/record-pr-demo-clips.ts",
    "electron:compile": "tsc -p tsconfig.electron.json && bun build electron/preload.ts --target=node --format=cjs --outfile dist-electron/preload.cjs",
    "desktop:dev": "bun run build && bun run electron:compile && electron .",
    "desktop:build": "bun run build && bun run electron:compile && electron-builder --win --publish never",
    "desktop:portable": "bun run build && bun run electron:compile && electron-builder --win portable",
    "desktop:sidecar": "bun build ../../backend/src/index.ts --compile --target=bun-windows-x64 --windows-hide-console --outfile resources/vyline-backend.exe"
  },
  "dependencies": {
    "@vyline/themes": "workspace:*",
    "@vyline/types": "workspace:*",
    "clsx": "^2.1.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.4",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.3.5"
  }
}
